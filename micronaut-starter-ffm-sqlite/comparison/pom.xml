<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>cmp</groupId><artifactId>${stack}</artifactId><version>1</version>
  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <stack>official</stack>
    <ffm-sqlite.version>0.2.4</ffm-sqlite.version>
    <!-- Perf runs: -Dperf.seconds=300; the SQLite builds: -Dsqlite-jdbc.version and -Dffmsqlite.lib. -->
    <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
    <ffmsqlite.lib></ffmsqlite.lib>
    <perf.jvm>-Xms512m -Xmx512m</perf.jvm>
    <perf.seconds></perf.seconds>
    <perf.warmup>30</perf.warmup>
    <perf.threads>8</perf.threads>
    <perf.dir>target/perf</perf.dir>
    <count.calls>false</count.calls>
    <wide.template>${project.basedir}/../../ffm-vs-jdbc/data/wide-1m.db</wide.template>
    <wide.threads>1,2,4,8,16</wide.threads>
    <caps.flag>false</caps.flag>
  </properties>
  <dependencyManagement><dependencies><dependency>
    <groupId>io.micronaut.platform</groupId><artifactId>micronaut-platform</artifactId><version>5.2.3</version><type>pom</type><scope>import</scope>
  </dependency></dependencies></dependencyManagement>
  <dependencies>
    <dependency><groupId>io.micronaut.data</groupId><artifactId>micronaut-data-jdbc</artifactId></dependency>
    <dependency><groupId>io.micronaut</groupId><artifactId>micronaut-management</artifactId></dependency>
    <dependency><groupId>io.micronaut.test</groupId><artifactId>micronaut-test-junit5</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-nop</artifactId><scope>test</scope></dependency>
  </dependencies>
  <profiles>
    <profile><id>official</id><activation><property><name>!starter</name></property></activation>
      <dependencies>
        <dependency><groupId>io.micronaut.sql</groupId><artifactId>micronaut-jdbc-hikari</artifactId></dependency>
        <dependency><groupId>io.micronaut.sql</groupId><artifactId>micronaut-jdbc-sqlite</artifactId></dependency>
        <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>${sqlite-jdbc.version}</version></dependency>
        <!-- also ffm-sqlite-jdbc, to run the official stack with the FFM driver -->
        <dependency><groupId>io.github.revsnai</groupId><artifactId>ffm-sqlite-jdbc</artifactId><version>${ffm-sqlite.version}</version></dependency>
      </dependencies>
      <properties><extra.src>src/test/java-official</extra.src></properties>
    </profile>
    <profile><id>starter</id><activation><property><name>starter</name></property></activation>
      <dependencies>
        <dependency><groupId>io.github.revsnai</groupId><artifactId>micronaut-starter-ffm-sqlite</artifactId><version>${ffm-sqlite.version}</version></dependency>
      </dependencies>
      <properties><extra.src>src/test/java-starter</extra.src></properties>
    </profile>
    <!-- -Dcaps: add micronaut-jdbc-sqlite (Micronaut Data then skips setReadOnly on SQLite connections). -->
    <profile><id>caps</id><activation><property><name>caps</name></property></activation>
      <properties><caps.flag>true</caps.flag></properties>
      <dependencies>
        <dependency><groupId>io.micronaut.sql</groupId><artifactId>micronaut-jdbc-sqlite</artifactId></dependency>
      </dependencies>
    </profile>
  </profiles>
  <build>
    <testResources><testResource><directory>src/test/resources</directory></testResource></testResources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version>
        <configuration><annotationProcessorPaths>
          <path><groupId>io.micronaut</groupId><artifactId>micronaut-inject-java</artifactId><version>5.2.17</version></path>
          <path><groupId>io.micronaut.data</groupId><artifactId>micronaut-data-processor</artifactId><version>5.2.3</version></path>
        </annotationProcessorPaths></configuration></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.3</version>
        <configuration>
          <argLine>--enable-native-access=ALL-UNNAMED ${perf.jvm}</argLine>
          <trimStackTrace>false</trimStackTrace>
          <systemPropertyVariables>
            <ffmsqlite.lib>${ffmsqlite.lib}</ffmsqlite.lib>
            <perf.seconds>${perf.seconds}</perf.seconds>
            <perf.warmup>${perf.warmup}</perf.warmup>
            <perf.threads>${perf.threads}</perf.threads>
            <perf.dir>${perf.dir}</perf.dir>
            <count.calls>${count.calls}</count.calls>
            <wide.template>${wide.template}</wide.template>
            <wide.threads>${wide.threads}</wide.threads>
            <caps>${caps.flag}</caps>
            <ffm-sqlite.version>${ffm-sqlite.version}</ffm-sqlite.version>
          </systemPropertyVariables>
        </configuration></plugin>
      <plugin><groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.0</version>
        <executions><execution><id>common</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals>
          <configuration><sources><source>${extra.src}</source></sources></configuration></execution></executions></plugin>
    </plugins>
  </build>
</project>
