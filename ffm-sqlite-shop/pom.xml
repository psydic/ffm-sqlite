<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Sample e-commerce application on ffm-sqlite-jdbc: a training project for integrating the driver.
      Standalone on purpose (no parent): copy this pom as the starting point of your own application.
    -->
    <groupId>io.github.revsnai.samples</groupId>
    <artifactId>ffm-sqlite-shop</artifactId>
    <version>0.1.0</version>
    <name>ffm-sqlite shop (sample)</name>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <ffm-sqlite.version>0.2.2</ffm-sqlite.version>
        <jackson.version>2.19.2</jackson.version>
        <!-- Tests: -Dffmsqlite.lib=/path/to/libsqlite3.so (empty = the system library). -->
        <ffmsqlite.lib></ffmsqlite.lib>
    </properties>

    <dependencies>
        <!-- The driver: jdbc:ffmsqlite: URLs, registered through ServiceLoader. Brings in ffm-sqlite. -->
        <dependency>
            <groupId>io.github.revsnai</groupId>
            <artifactId>ffm-sqlite-jdbc</artifactId>
            <version>${ffm-sqlite.version}</version>
        </dependency>
        <!-- Connection pool: one for writes (size 1) and one for reads. -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>7.0.2</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.17</version>
        </dependency>
        <!-- JSON for the HTTP API. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.12.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <!-- FFM needs native access; without the flag Java 25 prints a warning (a later JDK will refuse). -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
                        <ffmsqlite.lib>${ffmsqlite.lib}</ffmsqlite.lib>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <!-- target/ffm-sqlite-shop.jar: one runnable jar (java -jar target/ffm-sqlite-shop.jar). -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>ffm-sqlite-shop</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!-- Merges META-INF/services/java.sql.Driver so DriverManager finds jdbc:ffmsqlite:. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Main-Class>io.github.revsnai.shop.ShopApplication</Main-Class>
                                        <!-- Native access without a JVM flag when started with java -jar. -->
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
