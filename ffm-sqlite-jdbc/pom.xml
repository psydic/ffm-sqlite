<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.revsnai</groupId>
        <artifactId>ffm-sqlite-parent</artifactId>
        <version>0.2.6</version>
        <relativePath>../ffm-sqlite-parent/pom.xml</relativePath>
    </parent>

    <artifactId>ffm-sqlite-jdbc</artifactId>
    <packaging>jar</packaging>
    <name>ffm-sqlite-jdbc</name>
    <description>A JDBC driver (java.sql) for SQLite on top of ffm-sqlite: Foreign Function &amp; Memory API, no JNI</description>

    <properties>
        <module.name>io.github.revsnai.ffmsqlite.jdbc</module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.revsnai</groupId>
            <artifactId>ffm-sqlite</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The reference driver: compatibility tests run the same JDBC code against both. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.50.3.0</version>
            <scope>test</scope>
        </dependency>
        <!-- Third-party JDBC consumers: proof that the driver works unmodified with real frameworks. -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>7.0.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <version>7.0.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq</artifactId>
            <version>3.20.8</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.17</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
