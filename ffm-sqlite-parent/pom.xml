<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" child.project.url.inherit.append.path="false"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Parent and aggregator for the published artifacts:
        io.github.revsnai:ffm-sqlite       the FFM SQLite library (io.github.revsnai.ffmsqlite.db)
        io.github.revsnai:ffm-sqlite-jdbc  the java.sql driver on top of it (io.github.revsnai.ffmsqlite.jdbc)
      Release steps: RELEASING.md. The groupId must match a namespace you own on Maven Central
      (io.github.<github-username>, or a reversed domain you control).
    -->
    <groupId>io.github.revsnai</groupId>
    <artifactId>ffm-sqlite-parent</artifactId>
    <version>0.2.1</version>
    <packaging>pom</packaging>

    <name>ffm-sqlite parent</name>
    <description>SQLite for Java 25+ through the Foreign Function &amp; Memory API: a JDBC-style library and a java.sql driver, no JNI</description>
    <url>https://github.com/revsnai/ffm-sqlite</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>revsnai</name>
        <url>https://github.com/revsnai</url>
    </organization>

    <developers>
        <developer>
            <id>psydic</id>
            <name>Siddharth</name>
            <email>sid.infinity.yadav@gmail.com</email>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/revsnai/ffm-sqlite.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/revsnai/ffm-sqlite.git</developerConnection>
        <url>https://github.com/revsnai/ffm-sqlite</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/revsnai/ffm-sqlite/issues</url>
    </issueManagement>

    <modules>
        <module>../ffm-sqlite</module>
        <module>../ffm-sqlite-jdbc</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Reproducible builds: fixed timestamp in archives (update on release). -->
        <project.build.outputTimestamp>2026-10-24T18:45:12Z</project.build.outputTimestamp>
        <junit.version>5.12.2</junit.version>
        <!-- Tests: -Dffmsqlite.lib=/path/to/libsqlite3.so runs them against that SQLite (empty = system library). -->
        <ffmsqlite.lib></ffmsqlite.lib>
        <!-- Set per module: the JPMS name for module-path users (Automatic-Module-Name). -->
        <module.name>UNSET</module.name>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.revsnai</groupId>
                <artifactId>ffm-sqlite</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <!-- Ship the license inside every jar. -->
                <directory>${project.basedir}/../ffm-sqlite-parent</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                </includes>
            </resource>
        </resources>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                    <configuration>
                        <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                        <systemPropertyVariables>
                            <!-- Forwarded explicitly: a -DargLine override is ignored once argLine is set here. -->
                            <ffmsqlite.lib>${ffmsqlite.lib}</ffmsqlite.lib>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.12.0</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>require-java-25</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>ffm-sqlite needs JDK 25+ (Foreign Function &amp; Memory API).</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.6.3,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- Native access for class-path users, without a JVM flag when run with java -jar. -->
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                            <Automatic-Module-Name>${module.name}</Automatic-Module-Name>
                            <Implementation-Title>${project.artifactId}</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn -P release deploy : sources + javadoc jars, GPG signatures, upload to the Central Portal. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <doclint>all,-missing</doclint>
                            <links>
                                <link>https://docs.oracle.com/en/java/javase/25/docs/api/</link>
                            </links>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <!-- Credentials: <server><id>central</id> in ~/.m2/settings.xml (Central Portal user token). -->
                            <publishingServerId>central</publishingServerId>
                            <!-- Upload and validate, then publish by hand in the Portal UI; set true to publish automatically. -->
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          mvn -P github deploy : publish to GitHub Packages (https://github.com/revsnai/ffm-sqlite/packages), with
          sources and javadoc jars. Credentials: <server><id>github</id> (a token with write:packages); in GitHub
          Actions, actions/setup-java provides it from GITHUB_TOKEN (.github/workflows/publish-github-packages.yml).
        -->
        <profile>
            <id>github</id>
            <distributionManagement>
                <repository>
                    <id>github</id>
                    <name>GitHub revsnai Apache Maven Packages</name>
                    <url>https://maven.pkg.github.com/revsnai/ffm-sqlite</url>
                </repository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <doclint>all,-missing</doclint>
                            <links>
                                <link>https://docs.oracle.com/en/java/javase/25/docs/api/</link>
                            </links>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
